<Page x:Class="Mirage.Panel.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard">
    <ScrollViewer Padding="20" Background="#1E1E1E">
        <StackPanel>
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

            <WrapPanel Margin="0,0,0,20">
                <Border Background="#2D2D2D" BorderBrush="#3D3D3D" BorderThickness="1" Margin="6" Padding="16" MinWidth="150" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Sessions" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TotalSessions" FontSize="28" FontWeight="Bold" Foreground="White" Text="0"/>
                    </StackPanel>
                </Border>
                <Border Background="#2D2D2D" BorderBrush="#3D3D3D" BorderThickness="1" Margin="6" Padding="16" MinWidth="150" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Today" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="SessionsToday" FontSize="28" FontWeight="Bold" Foreground="White" Text="0"/>
                    </StackPanel>
                </Border>
                <Border Background="#2D2D2D" BorderBrush="#3D3D3D" BorderThickness="1" Margin="6" Padding="16" MinWidth="150" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Passwords" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TotalPasswords" FontSize="28" FontWeight="Bold" Foreground="White" Text="0"/>
                    </StackPanel>
                </Border>
                <Border Background="#2D2D2D" BorderBrush="#3D3D3D" BorderThickness="1" Margin="6" Padding="16" MinWidth="150" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Cookies" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TotalCookies" FontSize="28" FontWeight="Bold" Foreground="White" Text="0"/>
                    </StackPanel>
                </Border>
                <Border Background="#2D2D2D" BorderBrush="#3D3D3D" BorderThickness="1" Margin="6" Padding="16" MinWidth="150" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Wallets" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TotalWallets" FontSize="28" FontWeight="Bold" Foreground="White" Text="0"/>
                    </StackPanel>
                </Border>
                <Border Background="#2D2D2D" BorderBrush="#3D3D3D" BorderThickness="1" Margin="6" Padding="16" MinWidth="150" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="Cards" Foreground="#888" FontSize="11"/>
                        <TextBlock x:Name="TotalCards" FontSize="28" FontWeight="Bold" Foreground="White" Text="0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock x:Name="LastSessionInfo" Text="No sessions yet" Foreground="#888" Margin="6"/>
        </StackPanel>
    </ScrollViewer>
</Page>
