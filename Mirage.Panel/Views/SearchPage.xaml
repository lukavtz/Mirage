<Page x:Class="Mirage.Panel.Views.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Search" Background="{StaticResource MaterialDesignPaper}">
    <Grid Margin="20" MaxWidth="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Search passwords, URLs, usernames..."
                     KeyDown="SearchBox_KeyDown" Margin="0,0,10,0"/>
            <Button Grid.Column="1" Content="Search" Click="SearchClick"
                    Style="{StaticResource MaterialDesignRaisedButton}" VerticalAlignment="Center"/>
        </Grid>

        <DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False"
                  Style="{StaticResource MaterialDesignDataGrid}"
                  MouseDoubleClick="ResultsGrid_MouseDoubleClick"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="3*"/>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="2*"/>
                <DataGridTextColumn Header="Password" Binding="{Binding PasswordValue}" Width="2*"/>
                <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="*"/>
                <DataGridTextColumn Header="Session ID" Binding="{Binding SessionId}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
