<Page x:Class="Mirage.Panel.Views.SessionDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Session Detail" Background="{StaticResource MaterialDesignPaper}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Back" Click="BackClick"
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
            <TextBlock x:Name="HeaderText" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource MaterialDesignCard}" Padding="15" Margin="0,0,0,10">
            <WrapPanel>
                <TextBlock x:Name="SessionHwid" Margin="0,0,20,0" Foreground="Gray"/>
                <TextBlock x:Name="SessionIp" Margin="0,0,20,0" Foreground="Gray"/>
                <TextBlock x:Name="SessionOs" Margin="0,0,20,0" Foreground="Gray"/>
                <TextBlock x:Name="SessionUser" Margin="0,0,20,0" Foreground="Gray"/>
                <TextBlock x:Name="SessionCountry" Foreground="Gray"/>
            </WrapPanel>
        </Border>

        <TabControl Grid.Row="2" Style="{StaticResource MaterialDesignTabControl}">
            <TabItem Header="Passwords">
                <DataGrid x:Name="PasswordsGrid" AutoGenerateColumns="False"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="3*"/>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="2*"/>
                        <DataGridTextColumn Header="Password" Binding="{Binding PasswordValue}" Width="2*"/>
                        <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Cookies">
                <DataGrid x:Name="CookiesGrid" AutoGenerateColumns="False"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="2*"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="3*"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Cards">
                <DataGrid x:Name="CardsGrid" AutoGenerateColumns="False"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="2*"/>
                        <DataGridTextColumn Header="Expires" Binding="{Binding ExpMonth}" Width="*"/>
                        <DataGridTextColumn Header="Year" Binding="{Binding ExpYear}" Width="*"/>
                        <DataGridTextColumn Header="Holder" Binding="{Binding Holder}" Width="2*"/>
                        <DataGridTextColumn Header="CVC" Binding="{Binding Cvc}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Wallets">
                <DataGrid x:Name="WalletsGrid" AutoGenerateColumns="False"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Files">
                <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Filename" Binding="{Binding Filename}" Width="3*"/>
                        <DataGridTextColumn Header="Size (bytes)" Binding="{Binding Size}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="System Info">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource MaterialDesignCard}" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU:" FontWeight="Bold" Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SysCpu" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU:" FontWeight="Bold" Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SysGpu" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="RAM:" FontWeight="Bold" Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SysRam" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="OS:" FontWeight="Bold" Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SysOs" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Screen:" FontWeight="Bold" Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SysScreen" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Hostname:" FontWeight="Bold" Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SysHostname" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Local IP:" FontWeight="Bold" Margin="0,0,10,8"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="SysLocalIp" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="MAC:" FontWeight="Bold" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="SysMac"/>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
