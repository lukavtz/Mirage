# Copy to .env and provide unique secrets outside version control.
# Generate with: openssl rand -hex 32
DB_PASSWORD=
DATABASE_URL=postgres://mirage:<DB_PASSWORD>@postgres:5432/mirage?sslmode=disable
JWT_SECRET=
# Optional: LICENSE_SECRET, ALLOWED_ORIGINS, PANEL_PORT
APP_ENV=development
TLS_ENABLED=false
TLS_SELF_SIGNED=false
# Production: set APP_ENV=production, TLS_ENABLED=true, TLS_SELF_SIGNED=false,
# TLS_CERT_FILE=/run/secrets/tls.crt, TLS_KEY_FILE=/run/secrets/tls.key.
# Never commit .env or certificate/key files.
