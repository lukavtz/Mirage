# Copy to .env. DATABASE_URL must point at the compose postgres service.
DB_PASSWORD=change-me
DATABASE_URL=postgres://mirage:change-me@postgres:5432/mirage?sslmode=disable
JWT_SECRET=generate-with: openssl rand -hex 32
# Optional:
# LICENSE_SECRET=another long random hex string
# ALLOWED_ORIGINS=http://localhost:8080
# PANEL_PORT=8080
